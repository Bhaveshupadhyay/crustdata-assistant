# Crustdata AI Assistant — Environment Variables
# Copy this file to .env and fill in your values.

GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
DEBUG=false

# --- Upstash Redis ---
UPSTASH_REDIS_REST_URL=your-upstash-redis-url-here
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token-here

# --- Qdrant Vector DB ---
QDRANT_ENDPOINT=http://localhost:6333
QDRANT_KEY=your-qdrant-api-key-here

# --- PostgreSQL Database ---
POSTGRES_USERNAME=postgres
POSTGRES_DB_PASSWORD=your-postgres-password-here
POSTGRES_DB_HOST=localhost
